<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#E0F7FA"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvHeaderNamaBangunan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#006064"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Bangunan 1 — Tanggul Banjir" />

        <TextView
            android:id="@+id/tvHeaderKodeOp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#006064"
            android:textSize="12sp"
            tools:text="OP-01.b" />

        <!-- Lokasi menurut blangko OP; disembunyikan bila belum diisi -->
        <TextView
            android:id="@+id/tvHeaderLokasiBlangko"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#00838F"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Sungai Asam-asam · Km 3,2 s/d Km 3,8"
            tools:visibility="visible" />

        <!-- Titik lokasi bangunan; disembunyikan bila belum terekam -->
        <TextView
            android:id="@+id/tvHeaderKoordinat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#B2EBF2"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#006064"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="📍 -3.31438, 114.58959"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.cardview.widget.CardView>