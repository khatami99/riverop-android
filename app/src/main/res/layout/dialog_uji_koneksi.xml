<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alamat server"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Dapat diketik ulang pada build debug: alamat terowongan sementara
         berubah tiap kali dinyalakan, dan orang yang memegang HP belum tentu
         bisa membangun ulang APK. Build rilis mengunci kolom ini. -->
    <EditText
        android:id="@+id/etAlamatServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/surface_medium"
        android:fontFamily="monospace"
        android:hint="https://…"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:maxLines="2"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvPetunjukAlamat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Ubah alamat lalu tekan Uji Sekarang untuk menyimpannya."
        android:textColor="@color/text_secondary"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/tvKembalikanBawaan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="Kembalikan alamat bawaan"
        android:textColor="@color/primary_light"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHasilUji"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/barisMenunggu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Menghubungi server…"
            android:textColor="@color/text_body"
            android:textSize="13.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVersiAplikasi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_hint"
        android:textSize="11.5sp" />

</LinearLayout>
