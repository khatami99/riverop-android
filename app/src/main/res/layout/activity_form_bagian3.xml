<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_soft">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formulir OP Sungai"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bagian 3 dari 3: Isi Temuan Kondisi"
            android:textColor="@color/on_primary_muted"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Progress Bar -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@color/surface"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <View
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="?attr/colorPrimary" />

        <View
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="?attr/colorPrimary" />

        <View
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="?attr/colorPrimary" />

    </LinearLayout>

    <!-- Input nama/label bangunan -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardNamaBangunan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:layout_constraintTop_toBottomOf="@id/layoutProgress">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama / Label Bangunan *"
                android:textSize="12sp"
                android:textColor="@color/text_body" />

            <EditText
                android:id="@+id/etNamaBangunan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:background="@null"
                android:paddingTop="4dp"
                android:textSize="14sp" />

            <!-- Lokasi menurut blangko OP: "Sungai <nama> pada ruas antara
                 patok Km A s/d Km B". Tanpa ini baris Lokasi bangunan pada
                 blangko hasil cetak tidak pernah bisa lengkap. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/surface_medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nama Sungai"
                android:textSize="12sp"
                android:textColor="@color/text_body" />

            <EditText
                android:id="@+id/etNamaSungai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:imeOptions="actionNext"
                android:background="@null"
                android:hint="Contoh: Asam-asam"
                android:paddingTop="4dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ruas antara patok kilometer"
                android:textSize="12sp"
                android:textColor="@color/text_body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Km"
                    android:textSize="13sp"
                    android:textColor="@color/text_body" />

                <EditText
                    android:id="@+id/etKmDari"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    android:background="@null"
                    android:hint="0"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="s/d  Km"
                    android:textSize="13sp"
                    android:textColor="@color/text_body" />

                <EditText
                    android:id="@+id/etKmSampai"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:imeOptions="actionDone"
                    android:background="@null"
                    android:hint="0"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Titik lokasi bangunan -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/surface_medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ProgressBar
                    android:id="@+id/pbLokasi"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvIkonLokasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvStatusLokasi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Lokasi belum diambil"
                    android:textSize="12sp"
                    android:textColor="@color/text_body" />

                <Button
                    android:id="@+id/btnAmbilLokasi"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Ambil Lokasi"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_light" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- RecyclerView — id disesuaikan ke rvItemInspeksi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvItemInspeksi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/cardNamaBangunan"
        app:layout_constraintBottom_toTopOf="@id/cardBottom" />

    <!-- Bottom Card — tombol disesuaikan ke yang AI Studio generate -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@color/surface">

            <Button
                android:id="@+id/btnSimpanDraft3"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Simpan Konsep" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTambahBangunan"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+ Tambah Bangunan" />

            <Button
                android:id="@+id/btnSimpanLaporan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Simpan &amp; Kirim" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>